# ==============================================================================
# Official KernelSU x86_64 Builder Suite - Configuration File
# Target OS: Ubuntu 26.04 LTS (Resolute Raccoon) x86_64
# ==============================================================================

# Official Upstream KernelSU Repository & Branch
# Repository: https://github.com/tiann/KernelSU.git
# Branch/Tag: "main" (latest) or specific tag like "v3.1.0", "v3.3.1"
KSU_GIT_REPO="https://github.com/tiann/KernelSU.git"
KSU_GIT_BRANCH="main"

# maxsteeel/lkmloader release binary
LKMLOADER_RELEASE_URL="https://github.com/maxsteeel/lkmloader/releases/download/v1.0.0/lkmloader-x86_64"
LKMLOADER_SHA256="ea0a460350ccaaa9671cf1e3bd764f2421bec5a1948a21f0c85a3b4f06eaaba2"

# Linux kernel source download mirror (for missing SELinux headers)
KERNEL_CDN_BASE="https://cdn.kernel.org/pub/linux/kernel"

# Installation destination for systemd service and persistent runtime
INSTALL_DIR="/opt/kernelsu"

# Workspace directories
WORKSPACE_DIR="build_workspace"
OUTPUT_DIR="output"
